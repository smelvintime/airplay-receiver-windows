<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test harness for the FCUP/HLS pipeline.

       Deliberately NOT part of AirPlayReceiver.sln and NOT a WinUI project: it
       link-compiles the handful of receiver sources the pipeline actually needs,
       so it runs as a plain net8.0 console app with no WinUI, FFmpeg, or native
       dependency — and therefore runs anywhere, including CI.

       Run it with "dotnet run" against tests/HlsHarness in Release.
       Exit code 0 = every check passed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AirPlayReceiver.HlsHarness</RootNamespace>
    <AssemblyName>HlsHarness</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The pipeline under test, compiled from the real sources (not copies). -->
  <ItemGroup>
    <Compile Include="..\..\src\AirPlayReceiver\Services\Log.cs"             Link="Receiver\Log.cs" />
    <Compile Include="..\..\src\AirPlayReceiver\Services\HlsServer.cs"       Link="Receiver\HlsServer.cs" />
    <Compile Include="..\..\src\AirPlayReceiver\Media\HlsPlaylistStore.cs"   Link="Receiver\HlsPlaylistStore.cs" />
    <Compile Include="..\..\src\AirPlayReceiver\Protocol\HlsCoordinator.cs"  Link="Receiver\HlsCoordinator.cs" />
    <Compile Include="..\..\src\AirPlayReceiver\Protocol\ReverseChannel.cs"  Link="Receiver\ReverseChannel.cs" />
    <Compile Include="..\..\src\AirPlayReceiver\Protocol\RtspMessage.cs"     Link="Receiver\RtspMessage.cs" />
    <Compile Include="..\..\src\AirPlayReceiver\Protocol\BinaryPlist.cs"     Link="Receiver\BinaryPlist.cs" />
    <Compile Include="..\..\src\AirPlayReceiver\Protocol\XmlPlist.cs"        Link="Receiver\XmlPlist.cs" />
  </ItemGroup>

</Project>
